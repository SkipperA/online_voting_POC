# One hostname per origin, each to the port that origin listens on inside
# the container. The mapping is the whole of the proxy's job: it must not
# merge two origins behind one name, because the browser's same-origin
# policy is what enforces the component boundaries this design claims.
#
# Certificates are issued automatically over HTTP-01, so all nine names
# must resolve to this machine before the first start. A failed attempt
# counts against the rate limit, so check with `dig` first.
#
# No blank line before the global options block below: `caddy fmt`
# objects to one, and the objection arrives as a warning on every
# start, in among the lines read when something is actually wrong.
{
	email postmaster@{$OVPOC_DOMAIN}
}

# The apex is not an origin. It sends a reader to the configuration, which
# carries the legend naming the trust domains.
{$OVPOC_DOMAIN} {
	redir https://config.{$OVPOC_DOMAIN}{uri}
}

config.{$OVPOC_DOMAIN} {
	reverse_proxy ovpoc:8000
}
voter.{$OVPOC_DOMAIN} {
	reverse_proxy ovpoc:8001
}
wallet.{$OVPOC_DOMAIN} {
	reverse_proxy ovpoc:8002
}
vro.{$OVPOC_DOMAIN} {
	reverse_proxy ovpoc:8003
}
ebb.{$OVPOC_DOMAIN} {
	reverse_proxy ovpoc:8004
}
checker.{$OVPOC_DOMAIN} {
	reverse_proxy ovpoc:8005
}

# The two gated origins. The supervision register names citizens, and the
# setup console mints elections and replaces keys -- neither is a thing the
# design hands to whoever finds the URL.
#
# A password, and nothing else. There was an address allowance in front of
# this, on the reasoning that a password travelling to the wrong person is
# still a password while an address is harder to forward by accident. That
# reasoning holds for a deployment and is wrong for a demonstration: the
# supervision page *is* the oversight argument, and an allowance pinned to
# whoever configured the server means that in a room, on conference wifi,
# from a borrowed laptop, nobody can open the page the argument depends on.
# A perimeter that keeps out the audience is not protecting anything.
#
# So this is weaker than what it replaced, and the README says so in the
# terms that matter: anyone holding the password can mint an election over
# a running poll, from anywhere, which voids every token already issued.
# The guard against doing it by accident is in the console -- a mint must
# name the election it replaces -- and there is no guard against doing it
# on purpose. That is the correct amount of protection for a demonstration
# whose electorate is three personas, and it would not be for anything
# else.
supervisor.{$OVPOC_DOMAIN} {
	basic_auth {
		# caddy hash-password  -- then paste the hash here
		admin $2a$14$REPLACE_WITH_A_BCRYPT_HASH
	}
	reverse_proxy ovpoc:8006
}

setup.{$OVPOC_DOMAIN} {
	basic_auth {
		admin $2a$14$REPLACE_WITH_A_BCRYPT_HASH
	}
	reverse_proxy ovpoc:8009
}
